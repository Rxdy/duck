#!/usr/bin/env bash
set -euo pipefail

protected_branches=("main" "dev")
current_branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"

for branch in "${protected_branches[@]}"; do
  if [[ "$current_branch" == "$branch" ]]; then
    echo "Commit direct interdit sur la branche '$branch'." >&2
    echo "Crée une branche feature/* puis ouvre une pull request." >&2
    exit 1
  fi
done
