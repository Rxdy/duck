# Production (docker-compose.prod.yml). Copier en .env (ignoré par git) et remplacer le mot de passe :
#   openssl rand -base64 24 | tr -d '=+/'
POSTGRES_PASSWORD=changez-moi

# Optionnel : version précise des images (sinon « latest », mise à jour par Watchtower)
# TAG=v1.0.0

# Optionnel : origines autorisées pour CORS et WebSocket (par défaut https://duck.rxdy.fr)
# ALLOWED_ORIGINS=https://duck.rxdy.fr
